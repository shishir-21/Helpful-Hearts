# Copy to .env for local Docker Compose development.
# These values are local development defaults only; never use them in production.
POSTGRES_DB=helpful_hearts
POSTGRES_USER=helpful_hearts
POSTGRES_PASSWORD=helpful_hearts_dev_only
POSTGRES_PORT=5432

# Compose services connect to the database by service name.
DATABASE_URL=postgresql+psycopg://helpful_hearts:helpful_hearts_dev_only@db:5432/helpful_hearts

BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
